# ─── BACKEND CONFIGURATION ──────────────────────────────────────────────────
# Security key for signing JWT tokens. Generate a secure random string using:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-real-secure-random-hex-string-in-production

# Database Connection URL:
# SQLite (Local Development): sqlite:///./linkdrop.db
# PostgreSQL (Production): postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://linkdrop:linkdrop_pass@db:5432/linkdrop

# ─── FRONTEND CONFIGURATION ─────────────────────────────────────────────────
# The public-facing URL of the backend API.
# Note: Since Vite embeds this at build time, it must be available during docker build.
VITE_API_URL=http://localhost:8000
